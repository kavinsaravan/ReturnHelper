# ReturnsRunner Environment Variables
# Copy this file to .env and fill in your values

# API Configuration (for future backend integration)
API_BASE_URL=https://api.returnsrunner.com
API_KEY=your_api_key_here

# Email Service (for forwarded emails)
EMAIL_SERVICE_URL=https://email.returnsrunner.com
EMAIL_API_KEY=your_email_api_key

# Web Automation Service
AUTOMATION_SERVICE_URL=https://automation.returnsrunner.com
AUTOMATION_API_KEY=your_automation_api_key

# Shipping Providers
USPS_API_KEY=your_usps_api_key
UPS_API_KEY=your_ups_api_key
FEDEX_API_KEY=your_fedex_api_key

# Analytics (optional)
ANALYTICS_KEY=your_analytics_key

# Environment
NODE_ENV=development
