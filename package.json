{
  "name": "ReturnsRunner",
  "version": "1.0.0",
  "description": "AI-powered returns automation agent for online purchases",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "backend": "cd backend && npm start",
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm run web\" \"npm run backend\"",
    "web": "webpack serve --mode development",
    "build:web": "webpack --mode production",
    "test": "jest",
    "lint": "eslint .",
    "postinstall": "cd backend && npm install",
    "setup": "npm install && node verify-setup.js",
    "setup:env": "cp -n .env.example .env 2>/dev/null || true && cp -n backend/.env.example backend/.env 2>/dev/null || true"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "axios": "^1.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.73.0",
    "react-native-document-picker": "^9.1.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-mail": "^6.1.1",
    "react-native-reanimated": "^3.6.0",
    "react-native-safe-area-context": "^4.8.0",
    "react-native-screens": "^3.29.0",
    "react-native-vector-icons": "^10.0.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.23.5",
    "@react-native/babel-preset": "^0.73.18",
    "@react-native/eslint-config": "^0.73.1",
    "@react-native/metro-config": "^0.73.2",
    "@react-native/typescript-config": "^0.73.1",
    "@types/react": "^18.2.45",
    "@types/react-native": "^0.72.8",
    "ajv": "^8.18.0",
    "ajv-keywords": "^5.1.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.1.1",
    "concurrently": "^9.1.2",
    "eslint": "^8.55.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.6",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "typescript": "^5.3.3",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  },
  "engines": {
    "node": ">=18"
  }
}
