# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration
# Leave empty to run without MongoDB (uses in-memory storage)
MONGODB_URI=

# Optional: For production with MongoDB
# MONGODB_URI=mongodb://localhost:27017/returnsrunner
# Or with MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/returnsrunner

# Shipping Provider APIs (for production)
USPS_API_KEY=
UPS_API_KEY=
FEDEX_API_KEY=

# Email Service (for production)
EMAIL_SERVICE_API_KEY=

# JWT Secret (for authentication in production)
JWT_SECRET=your_jwt_secret_here_change_in_production

# Browser Automation Configuration
HEADLESS_BROWSER=false
DEBUG_MODE=true
BROWSER_SLOW_MO=100

# Mock Retailer URLs (for testing)
MOCK_AMAZON_URL=http://localhost:5000/mock/amazon-returns.html
MOCK_TARGET_URL=http://localhost:5000/mock/target-returns.html
MOCK_WALMART_URL=http://localhost:5000/mock/walmart-returns.html
